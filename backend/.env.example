# Server Configuration
PORT=5000
NODE_ENV=development

# OPTION A: Neon PostgreSQL (Recommended for Vercel)
# Obtain this from your Neon Console (https://console.neon.tech)
DATABASE_URL=postgresql://<username>:<password>@<neon-hostname>.neon.tech/<dbname>?sslmode=require

# OPTION B: MongoDB Atlas
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studentportal?retryWrites=true&w=majority&appName=Cluster0

# Allowed Client Origin (for CORS)
# In development: http://localhost:5173
# In production on Render: URL of your deployed frontend (e.g., https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173
